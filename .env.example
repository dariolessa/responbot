# Variables de entorno de Responbot (docs/SPEC.md, sección Vercel).
# Copiá este archivo a .env.local para desarrollo. En Vercel se cargan en
# Project Settings → Environment Variables. lib/env.ts valida todo al arrancar.
# Las marcadas "(Fase N)" son opcionales hasta que esa fase se implemente.

# --- Base de datos -----------------------------------------------------------
# Postgres de Neon. En Vercel la crea la integración de Neon del Marketplace.
DATABASE_URL=postgres://usuario:clave@ep-xxxx.sa-east-1.aws.neon.tech/agendabot?sslmode=require

# --- Auth.js -----------------------------------------------------------------
# Firma de sesiones. Generala con: openssl rand -base64 32
AUTH_SECRET=
# URL pública de la app (en local: http://localhost:3000). En Vercel es opcional.
AUTH_URL=http://localhost:3000
# Cliente OAuth de Google Cloud (tipo aplicación web)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Correo (Resend) ---------------------------------------------------------
# API key de Resend (empieza con re_)
RESEND_API_KEY=
# Remitente con dominio verificado, por ejemplo: Responbot <hola@tudominio.com>
EMAIL_FROM=
# Secreto del webhook de rebotes y quejas (Fase 4)
RESEND_WEBHOOK_SECRET=

# --- Meta / WhatsApp Cloud API (Fase 3) --------------------------------------
# Paso a paso en docs/WHATSAPP.md. Sin estas cuatro, WhatsApp aparece como "Muy pronto".
# App de Meta y firma de webhooks
META_APP_ID=
META_APP_SECRET=
# Configuración de Embedded Signup
META_CONFIG_ID=
# Token que elegís vos para la verificación del webhook (hub.verify_token)
WHATSAPP_VERIFY_TOKEN=
# Versión de la Graph API (por defecto v23.0)
WHATSAPP_API_VERSION=v23.0

# --- IA (Fase 2) y transcripción (Fase 3) ------------------------------------
# Clave de https://console.anthropic.com. Sin ella el panel funciona, pero el chat de prueba queda deshabilitado
# y los mensajes de WhatsApp quedan para que los responda una persona.
ANTHROPIC_API_KEY=
# Transcripción de audios de WhatsApp: openai o elevenlabs, con su API key. Sin esto el bot pide que escriban.
TRANSCRIBER_PROVIDER=
TRANSCRIBER_API_KEY=

# --- Mercado Pago (Fase 5) ---------------------------------------------------
# Paso a paso en docs/MERCADOPAGO.md. Sin las dos primeras, Mercado Pago aparece
# como "Muy pronto" y los turnos se confirman sin seña.
# Client ID y Client Secret de la aplicación (Tus integraciones)
MP_CLIENT_ID=
MP_CLIENT_SECRET=
# Clave secreta de los webhooks (valida la firma x-signature)
MP_WEBHOOK_SECRET=

# --- Stripe, cobro del SaaS (Fase 6) -----------------------------------------
# Paso a paso en docs/STRIPE.md. Sin la clave y los tres precios, Facturación
# muestra los planes como "Muy pronto" (la prueba de 14 días corre igual).
# Clave secreta (sk_live_... o sk_test_... en previews)
STRIPE_SECRET_KEY=
# Secreto del endpoint del webhook (whsec_...)
STRIPE_WEBHOOK_SECRET=
# IDs de precio mensual de cada plan (price_...)
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# --- Landing y legales (Fase 6) ----------------------------------------------
# Contacto y razón social que muestran la landing, los términos y la privacidad.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_LEGAL_NAME=

# --- Pilotos y demo (Fase 7) -------------------------------------------------
# Emails, separados por coma, que pueden entrar al panel de la plataforma (/admin).
PLATFORM_ADMIN_EMAILS=
# Número de WhatsApp de la demo pública, solo dígitos con código de país (59899123456).
# Si está, la landing muestra "Probalo en WhatsApp".
NEXT_PUBLIC_DEMO_WHATSAPP=

# --- Push web (Fase 4) -------------------------------------------------------
# Generalas con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:hola@tudominio.com
VAPID_SUBJECT=

# --- Seguridad ---------------------------------------------------------------
# 32 bytes en base64 para cifrar tokens (AES-256-GCM): openssl rand -base64 32
ENCRYPTION_KEY=
# Protege las rutas de cron (Vercel lo manda como Authorization: Bearer ...)
# Generalo con: openssl rand -hex 32
CRON_SECRET=

# --- Servicios de Vercel -----------------------------------------------------
# Vercel Blob (lo crea la integración)
BLOB_READ_WRITE_TOKEN=
# Sentry (lo crea la integración)
SENTRY_DSN=
